<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The runtime lives in its own process: it reserves ~12.8 GB of guest address space, exits the process when the game ends and must never share an address space
             with another Nebulos core (or with the Odyssey, Dread or TotK runtime). -->
        <activity
            android:name="com.noryan.nebulos.core.sm3dw.Sm3dwActivity"
            android:process=":sm3dw"
            android:taskAffinity="com.noryan.nebulos.sm3dw"
            android:launchMode="singleTask"
            android:exported="false"
            android:alwaysRetainTaskState="true"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density" />
    </application>
</manifest>
