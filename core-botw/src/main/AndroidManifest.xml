<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- The whole BOTWRecompAndroid runtime lives in its own process: it reserves ~12.8 GB of guest address space, exits the
             process when the game ends and must never share an address space with another Nebulos core (or with the TotK runtime). -->
        <activity
            android:name="com.noryan.nebulos.core.botw.BotwActivity"
            android:process=":botw"
            android:taskAffinity="com.noryan.nebulos.botw"
            android:launchMode="singleTask"
            android:exported="false"
            android:alwaysRetainTaskState="true"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density" />
    </application>
</manifest>
