diff --git a/build.gradle.kts b/build.gradle.kts
index 5b0db6e5..6b0283c2 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -1,5 +1,18 @@
+// Nebulos: this build is consumed as an included build (includeBuild("../watermelonds-src")) of Nebulos, whose Android Gradle
+// plugin is 9.2.1 (Kotlin built in, no kotlin-android plugin). `:app` is an Android *library* here; the application,
+// signing and Hilt Gradle plugins are gone (Nebulos' own :app owns them).
+buildscript {
+    repositories {
+        google()
+        mavenCentral()
+    }
+    dependencies {
+        // AGP 9 compiles with the Kotlin Gradle plugin found on this classpath; Nebulos is on Kotlin 2.4.0 and its libraries need a matching compiler.
+        classpath("org.jetbrains.kotlin:kotlin-gradle-plugin:2.4.0")
+    }
+}
+
 plugins {
-    alias(libs.plugins.android.application) apply false
     alias(libs.plugins.android.library) apply false
     alias(libs.plugins.compose.compiler) apply false
     alias(libs.plugins.hilt.android) apply false
@@ -9,6 +22,14 @@ plugins {
     alias(libs.plugins.ksp) apply false
 }
 
+subprojects {
+    // Nebulos: JDK 17 everywhere
+    tasks.withType<JavaCompile>().configureEach {
+        sourceCompatibility = "17"
+        targetCompatibility = "17"
+    }
+}
+
 tasks.register("clean", Delete::class) {
     delete(rootProject.layout.buildDirectory)
 }
