+package me.magnum.melonds.nebulos
+
+import android.content.Context
+import android.net.Uri
+import androidx.documentfile.provider.DocumentFile
+import java.io.File
+
+/** Directory counterpart of [romDocumentFor]: `file:` tree URIs (e.g. BIOS dirs written by Nebulos) are plain directories. */
+fun treeDocumentFor(context: Context, uri: Uri): DocumentFile? {
+    if (uri.scheme != "file") return DocumentFile.fromTreeUri(context, uri)
+    val path = uri.path ?: return null
+    return DocumentFile.fromFile(File(path))
+}
+
+/** Nebulos hands the engine plain `file:` URIs (no SAF grants): DocumentFile.fromTreeUri/fromSingleUri cannot read those. (Reconstructed.) */
+fun romDocumentFor(context: Context, uri: Uri): DocumentFile? {
+    if (uri.scheme != "file") return DocumentFile.fromSingleUri(context, uri)
+    val path = uri.path ?: return null
+    return DocumentFile.fromFile(File(path))
+}
