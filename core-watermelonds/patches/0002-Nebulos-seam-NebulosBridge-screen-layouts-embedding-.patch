+package me.magnum.melonds.nebulos
+
+import android.util.Log
+import android.view.KeyEvent
+import android.view.MotionEvent
+import kotlinx.coroutines.flow.MutableStateFlow
+
+/**
+ * Nebulos seam (RECONSTRUCTED from the decompiled Release 15 build; the original source was lost).
+ *
+ * WatermelonDS runs embedded in Nebulos' `:melonds` process. Nebulos owns all UI (menu, toasts, dialogs, loading
+ * overlay, input routing); this object forwards the engine's UI events to the registered [Host]. Calls made before
+ * a host is registered are queued and replayed in order when [host] is set.
+ */
+object NebulosBridge {
+    /** Intent extra (Boolean) set by Nebulos on the EmulatorActivity intent: the Activity is running inside Nebulos. */
+    const val EXTRA_NEBULOS = "nebulos"
+
+    interface Host {
+        /** Key event from the game Activity; true = consumed (Nebulos' InputRouter handles it). */
+        fun onKey(event: KeyEvent): Boolean
+        fun onMotion(event: MotionEvent): Boolean
+        fun onMenuRequested()
+        fun notice(text: String, durationMs: Long) {}
+        fun error(title: String, message: String, fatal: Boolean) {}
+        fun ready() {}
+        /** [fraction] is NaN when indeterminate. */
+        fun loading(fraction: Float, text: String?) {}
+    }
+
+    /** Which screen arrangement Nebulos wants (see [NebulosScreenLayouts]); published by the Nebulos core session. */
+    val screenLayout = MutableStateFlow(NebulosScreenLayout(NebulosScreenLayouts.Mode.NEBULOS, false))
+
+    private val pending = ArrayList<(Host) -> Unit>()
+
+    @Volatile
+    var host: Host? = null
+        set(value) {
+            field = value
+            if (value != null) {
+                val queued = synchronized(pending) { ArrayList(pending).also { pending.clear() } }
+                queued.forEach { it(value) }
+            }
+        }
+
+    /** True while the running EmulatorActivity was started by Nebulos (set in EmulatorActivity.onCreate). */
+    @JvmStatic
+    @Volatile
+    var active: Boolean = false
+
+    private fun withHost(log: String, call: (Host) -> Unit) {
+        val h = host
+        if (h != null) {
+            call(h)
+            return
+        }
+        Log.i("Nebulos", "queued (no host yet): $log")
+        synchronized(pending) { pending.add(call) }
+    }
+
+    @JvmStatic
+    fun ready() = withHost("ready") { it.ready() }
+
+    @JvmStatic
+    fun loading(fraction: Float, text: String?) = withHost("loading $text") { it.loading(fraction, text) }
+
+    /** [long] = show for 5 s instead of 2.5 s (the long duration is a reconstruction guess). */
+    @JvmStatic
+    @JvmOverloads
+    fun notice(text: String, long: Boolean = false) = withHost("notice $text") { it.notice(text, if (long) 5000L else 2500L) }
+
+    @JvmStatic
+    @JvmOverloads
+    fun error(title: String, message: String, fatal: Boolean = true) = withHost("error $title: $message") { it.error(title, message, fatal) }
+}
