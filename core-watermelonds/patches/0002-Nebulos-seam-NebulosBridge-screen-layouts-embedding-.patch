--- /dev/null
+++ b/app/src/main/java/me/magnum/melonds/nebulos/NebulosScreenLayouts.kt
@@ -0,0 +1,83 @@
+package me.magnum.melonds.nebulos
+
+import me.magnum.melonds.domain.model.Rect
+import me.magnum.melonds.domain.model.consoleAspectRatio
+import me.magnum.melonds.domain.model.layout.LayoutComponent
+import me.magnum.melonds.domain.model.layout.PositionedLayoutComponent
+import me.magnum.melonds.domain.model.layout.UILayout
+import me.magnum.melonds.domain.model.layout.UILayoutVariant
+import kotlin.math.min
+
+/**
+ * Screen arrangements Nebulos offers (RECONSTRUCTED from the decompiled build; behaviour matches it):
+ *  - NEBULOS: one screen fills the display (integer scale when it fits), the other one at 1x in the top-right corner (picture-in-picture)
+ *  - SINGLE: one screen only
+ *  - STACKED: big screen on top, the other one below
+ * [NebulosScreenLayout.bottomFocus] swaps which screen is the main one.
+ */
+object NebulosScreenLayouts {
+    enum class Mode { NEBULOS, SINGLE, STACKED }
+
+    const val PIP_GAP = 16
+
+    fun apply(layout: UILayout, variant: UILayoutVariant, choice: NebulosScreenLayout): UILayout {
+        val insets = variant.uiInsets
+        val left = insets.left
+        val top = insets.top
+        val x = variant.uiSize.x - insets.left - insets.right
+        val y = variant.uiSize.y - insets.top - insets.bottom
+        val primary = if (choice.bottomFocus) LayoutComponent.BOTTOM_SCREEN else LayoutComponent.TOP_SCREEN
+        val other = if (choice.bottomFocus) LayoutComponent.TOP_SCREEN else LayoutComponent.BOTTOM_SCREEN
+
+        val components = when (choice.mode) {
+            Mode.NEBULOS -> {
+                val scale = min(x / 256, y / 192)
+                val fit = if (scale >= 1) Rect((x - scale * 256) / 2, (y - scale * 192) / 2, scale * 256, scale * 192) else fit(x, y)
+                val gap = if (scale >= 1) PIP_GAP else 0
+                val pipW = if (scale < 1) fit.width / 4 else 256
+                val pipH = if (scale < 1) fit.height / 4 else 192
+                listOf(
+                    PositionedLayoutComponent(Rect(fit.x + left, fit.y + top, fit.width, fit.height), primary),
+                    PositionedLayoutComponent(Rect(left + x - pipW - gap, top + gap, pipW, pipH), other, onTop = true),
+                )
+            }
+            Mode.SINGLE -> {
+                val scale = min(x / 256, y / 192)
+                val fit = if (scale >= 1) Rect((x - scale * 256) / 2, (y - scale * 192) / 2, scale * 256, scale * 192) else fit(x, y)
+                listOf(PositionedLayoutComponent(Rect(fit.x + left, fit.y + top, fit.width, fit.height), primary))
+            }
+            Mode.STACKED -> {
+                val scale = min(x / 256, (y - 192) / 192)
+                if (scale < 1) {
+                    val topH = y * 2 / 3
+                    val topW = (consoleAspectRatio * topH).toInt()
+                    val bottomH = y - topH
+                    val bottomW = (consoleAspectRatio * bottomH).toInt()
+                    listOf(
+                        PositionedLayoutComponent(Rect((x - topW) / 2 + left, top, topW, topH), primary),
+                        PositionedLayoutComponent(Rect((x - bottomW) / 2 + left, top + topH, bottomW, bottomH), other),
+                    )
+                } else {
+                    val w = scale * 256
+                    val h = scale * 192
+                    listOf(
+                        PositionedLayoutComponent(Rect((x - w) / 2 + left, top, w, h), primary),
+                        PositionedLayoutComponent(Rect((x - 256) / 2 + left, top + h, 256, 192), other),
+                    )
+                }
+            }
+        }
+        return layout.copy(mainScreenLayout = layout.mainScreenLayout.copy(components = components))
+    }
+
+    /** Largest console-aspect rectangle that fits [w] x [h], centered. */
+    internal fun fit(w: Int, h: Int): Rect {
+        return if (w.toFloat() / h > consoleAspectRatio) {
+            val fitted = (consoleAspectRatio * h).toInt()
+            Rect((w - fitted) / 2, 0, fitted, h)
+        } else {
+            val fitted = (w / consoleAspectRatio).toInt()
+            Rect(0, (h - fitted) / 2, w, fitted)
+        }
+    }
+}
