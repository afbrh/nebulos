+package me.magnum.melonds.impl
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import me.magnum.melonds.domain.repositories.DSiWareMetadataRepository
+import java.io.File
+import java.io.FileNotFoundException
+
+/**
+ * Nebulos replacement for NusDSiWareMetadataRepository (RECONSTRUCTED). The stock repository downloads the 520-byte DSi TMD
+ * from Nintendo's NUS over HTTP, but Nebulos has no network permission. Nebulos' DsiSupport.kt (`DsiWareCia.writeDsiTmd`)
+ * builds that TMD from the DSiWare .cia and writes it to
+ * `<externalFilesDir>/watermelonds/dsiware/tmd/<categoryHex8><titleHex8>.tmd`; this repository reads it back.
+ */
+class LocalDSiWareMetadataRepository(private val context: Context) : DSiWareMetadataRepository {
+
+    override suspend fun getDSiWareTitleMetadata(categoryId: UInt, titleId: UInt): ByteArray = withContext(Dispatchers.IO) {
+        val categoryIdHex = categoryId.toString(16).padStart(8, '0')
+        val titleIdHex = titleId.toString(16).padStart(8, '0')
+        val file = File(tmdDir(), "$categoryIdHex$titleIdHex.tmd")
+        if (!file.isFile) {
+            throw FileNotFoundException("No local DSi TMD for title $categoryIdHex$titleIdHex (${file.absolutePath})")
+        }
+        // Only 520 bytes are needed
+        val tmdMetadata = ByteArray(520)
+        file.inputStream().use { input ->
+            var offset = 0
+            while (offset < tmdMetadata.size) {
+                val read = input.read(tmdMetadata, offset, tmdMetadata.size - offset)
+                if (read <= 0) break
+                offset += read
+            }
+            if (offset < tmdMetadata.size) throw FileNotFoundException("DSi TMD ${file.name} is too short ($offset bytes)")
+        }
+        tmdMetadata
+    }
+
+    private fun tmdDir(): File = File(File(context.getExternalFilesDir(null) ?: context.filesDir, "watermelonds/dsiware"), "tmd")
+}
