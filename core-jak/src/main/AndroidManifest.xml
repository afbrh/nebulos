<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The whole OpenGOAL runtime (libjak_main.so with SDL3 linked statically, its GLES context, SDL state and the
             game-data extractor child process) lives in its own process; it is ended on Close Game. -->
        <activity
            android:name="com.noryan.nebulos.core.jak.JakActivity"
            android:process=":jak"
            android:taskAffinity="com.noryan.nebulos.jak"
            android:launchMode="singleTask"
            android:exported="false"
            android:alwaysRetainTaskState="true"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density" />
    </application>
</manifest>
