From f46dda57aca30ea0bf46f7c43cd4808eaa458bb1 Mon Sep 17 00:00:00 2001
From: Nebulos <n@x>
Date: Sun, 8 Nov 2026 21:15:18 -0600
Subject: [PATCH 7/8] Nebulos: InputOverrider shake base (RECONSTRUCTED;
 original patch lost)

---
 Source/Core/Core/HW/WiimoteEmu/Dynamics.cpp           | 11 +++++++++--
 Source/Core/Core/HW/WiimoteEmu/Dynamics.h             |  3 ++-
 Source/Core/Core/HW/WiimoteEmu/Extension/Nunchuk.cpp  |  2 +-
 Source/Core/Core/HW/WiimoteEmu/WiimoteEmu.cpp         |  2 +-
 .../DolphinQt/Config/Mapping/MappingIndicator.cpp     |  2 +-
 .../ControllerInterface/Touch/InputOverrider.cpp      |  2 ++
 .../ControllerInterface/Touch/InputOverrider.h        |  4 +++-
 7 files changed, 19 insertions(+), 7 deletions(-)

diff --git a/Source/Core/Core/HW/WiimoteEmu/Dynamics.cpp b/Source/Core/Core/HW/WiimoteEmu/Dynamics.cpp
index ebf24f735c..ff7b97924b 100644
--- a/Source/Core/Core/HW/WiimoteEmu/Dynamics.cpp
+++ b/Source/Core/Core/HW/WiimoteEmu/Dynamics.cpp
@@ -80,9 +80,16 @@ Common::Quaternion ComplementaryFilter(const Common::Quaternion& gyroscope,
 }
 
 void EmulateShake(PositionalState* state, ControllerEmu::Shake* const shake_group,
-                  float time_elapsed)
+                  const ControllerEmu::InputOverrideFunction& override_func, float time_elapsed)
 {
-  auto target_position = shake_group->GetState() * float(shake_group->GetIntensity() / 2);
+  auto shake_state = shake_group->GetState();
+  // Nebulos: touch/gamepad InputOverrider can hold the shake gesture on; the Shake group's own
+  // shake emulation (its own intensity and frequency).
+  if (override_func)
+    if (const auto o = override_func("NebulosShake", "On", 0.0))
+      if (*o > 0.5)
+        shake_state = Common::Vec3(1.f, 0.f, 0.f);
+  auto target_position = shake_state * float(shake_group->GetIntensity() / 2);
   for (std::size_t i = 0; i != target_position.data.size(); ++i)
   {
     if (state->velocity.data[i] * std::copysign(1.f, target_position.data[i]) < 0 ||
diff --git a/Source/Core/Core/HW/WiimoteEmu/Dynamics.h b/Source/Core/Core/HW/WiimoteEmu/Dynamics.h
