<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <application>

        <!-- The whole Eden runtime lives in its own process so libyuzu-android.so, Vulkan and its GL/EGL state never
             share an address space with other Nebulos cores. -->
        <activity
            android:name="org.yuzu.yuzu_emu.activities.EmulationActivity"
            android:process=":eden"
            android:taskAffinity="com.noryan.nebulos.eden"
            android:enableOnBackInvokedCallback="true"
            android:exported="false"
            tools:node="merge"
            android:theme="@style/Theme.NebulosEden"
            android:screenOrientation="landscape"
            tools:replace="android:exported,android:theme,android:screenOrientation">
            <!-- Nebulos launches this explicitly; drop the public VIEW/NFC filters of the stock app. -->
            <intent-filter tools:node="removeAll" />
        </activity>

        <service
            android:name="org.yuzu.yuzu_emu.utils.ForegroundService"
            android:process=":eden"
            tools:node="merge" />

        <!-- Internal game-file dump (EdenGameDump). Exported only so `adb shell am start-foreground-service` can reach it;
             android.permission.DUMP is held by the adb shell and the system, never by an installed app. -->
        <service
            android:name=".EdenDumpService"
            android:process=":eden"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="dataSync" />

        <!-- Runs in :eden before Application.onCreate: initialises Eden (the stock YuzuApplication never runs because
             the Nebulos app has its own Application) and installs the Nebulos input/menu hooks. -->
        <provider
            android:name="com.noryan.nebulos.core.eden.EdenInitProvider"
            android:authorities="${applicationId}.nebulos.eden.init"
            android:process=":eden"
            android:exported="false"
            android:initOrder="100" />
    </application>
</manifest>
