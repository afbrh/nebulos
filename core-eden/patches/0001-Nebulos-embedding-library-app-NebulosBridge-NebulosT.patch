@@ -0,0 +1,58 @@
+// SPDX-FileCopyrightText: Copyright 2026 Nebulos
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package org.yuzu.yuzu_emu.utils
+
+import android.util.Log
+
+/**
+ * The seam between Eden and the Nebulos shell. Eden never shows its own toasts or error dialogs when embedded: they are routed here, and
+ * the Nebulos core (core-eden, EdenHost) installs the callbacks while a game Activity is up. Results that arrive before the callbacks
+ * exist are held ([fireReady] keeps a pending flag, [flushPending] replays it).
+ */
+object NebulosBridge {
+    @Volatile var notice: ((String) -> Unit)? = null
+    @Volatile var error: ((String, String, Boolean) -> Unit)? = null
+    @Volatile var ready: (() -> Unit)? = null
+    @Volatile var progress: ((Float, String?) -> Unit)? = null
+    @Volatile var loadingText: ((String) -> Unit)? = null
+
+    /** Portable save folder (`<save root>/eden/save`); applied between config load and System init (see DirectoryInitialization). */
+    @Volatile var saveDir: String? = null
+
+    @Volatile private var pendingReady = false
+    @Volatile var fatalShown = false
+    private val errorLock = Object()
+
+    fun notice(msg: CharSequence) {
+        Log.i("Nebulos", " notice: $msg")
+        notice?.invoke(msg.toString())
+    }
+
+    fun error(title: String, message: String, fatal: Boolean) {
+        Log.e("Nebulos", " error: $title - $message")
+        if (fatal) fatalShown = true
+        error?.invoke(title, message, fatal)
+    }
+
+    /** The game drew its first frame. */
+    fun fireReady() {
+        val r = ready
+        if (r == null) pendingReady = true else r()
+    }
+
+    fun flushPending() {
+        if (pendingReady) {
+            pendingReady = false
+            ready?.invoke()
+        }
+    }
+
+    /** After a fatal error the emulation thread must not carry on: park it until the process ends. */
+    fun parkAfterFatal() {
+        fatalShown = true
+        synchronized(errorLock) {
+            while (true) errorLock.wait()
+        }
+    }
+}
diff --git a/src/android/app/src/main/java/org/yuzu/yuzu_emu/utils/NebulosToast.kt b/src/android/app/src/main/java/org/yuzu/yuzu_emu/utils/NebulosToast.kt
