@@ -0,0 +1,26 @@
+// SPDX-FileCopyrightText: Copyright 2026 Nebulos
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package org.yuzu.yuzu_emu.utils
+
+import android.content.Context
+
+/**
+ * Drop-in for android.widget.Toast (imported `as Toast` where Eden used Toast): the text goes to the Nebulos banner via [NebulosBridge]
+ * instead of an Android toast.
+ */
+class NebulosToast private constructor(private var text: CharSequence) {
+    fun show() = NebulosBridge.notice(text)
+    fun cancel() {}
+    fun setText(t: CharSequence) { text = t }
+    fun setDuration(d: Int) {}
+    fun setGravity(gravity: Int, x: Int, y: Int) {}
+
+    companion object {
+        const val LENGTH_SHORT = 0
+        const val LENGTH_LONG = 1
+
+        @JvmStatic fun makeText(ctx: Context?, resId: Int, duration: Int) = NebulosToast(ctx?.getText(resId) ?: "")
+        @JvmStatic fun makeText(ctx: Context?, text: CharSequence, duration: Int) = NebulosToast(text)
+    }
+}
