@@ -82,8 +68,33 @@ class YuzuApplication : Application() {
         var documentsTree: DocumentsTree? = null
         lateinit var application: YuzuApplication
 
+        /** Set when Eden runs embedded in another app (Nebulos): that app's Application context. */
+        private var hostContext: Context? = null
+
         val appContext: Context
-            get() = application.applicationContext
+            get() = hostContext ?: application.applicationContext
+
+        /** The whole of Eden's start-up, for [YuzuApplication.onCreate] and for a host app that has its own Application class. */
+        private fun initializeCore(hostApplication: Application) {
+            hostContext = hostApplication.applicationContext
+            if (documentsTree == null) documentsTree = DocumentsTree()
+            DirectoryInitialization.start()
+
+            // Initialize Freedreno config BEFORE loading native library
+            // This ensures GPU driver environment variables are set before adrenotools initializes
+            GpuDriverHelper.initializeFreedrenoConfigEarly()
+
+            NativeLibrary.playTimeManagerInit()
+            GpuDriverHelper.initializeDriverParameters()
+            NativeInput.reloadInputDevices()
+            NativeLibrary.logDeviceInfo()
+            PowerStateUpdater.start()
+            Log.logDeviceInfo()
+            ControllerNavigationGlobalHook.install(hostApplication)
+        }
+
+        /** Nebulos: Eden's own YuzuApplication is never instantiated, so the host calls this from its content provider before anything else. */
+        fun initializeForEmbedding(hostApplication: Application) = initializeCore(hostApplication)
 
         private val LANGUAGE_CODES = arrayOf(
             "system", "en", "es", "fr", "de", "it", "pt", "pt-BR", "ru", "ja", "ko",
