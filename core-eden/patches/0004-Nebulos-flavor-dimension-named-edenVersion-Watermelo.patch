From bf0ec514468c3ce97e99d85cfc5c5aea501ff76f Mon Sep 17 00:00:00 2001
From: ry <noreply@local>
Date: Sun, 8 Nov 2026 22:10:54 -0600
Subject: [PATCH 4/7] Nebulos: flavor dimension named edenVersion (WatermelonDS
 has its own 'version' dimension)

---
 src/android/app/build.gradle.kts | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/src/android/app/build.gradle.kts b/src/android/app/build.gradle.kts
index 4d438827f..312416f07 100644
--- a/src/android/app/build.gradle.kts
+++ b/src/android/app/build.gradle.kts
@@ -131,11 +131,12 @@ android {
 
     // appNameBase is used for the primary identifier
     // this should be "Eden <flavorName>"
-    flavorDimensions.add("version")
+    // Nebulos: not "version", which WatermelonDS also uses for a different set of flavors.
+    flavorDimensions.add("edenVersion")
     productFlavors {
         create("mainline") {
             manifestPlaceholders += mapOf("appNameBase" to "Eden")
-            dimension = "version"
+            dimension = "edenVersion"
             isDefault = true
             minSdk = 33
 
@@ -148,7 +149,7 @@ android {
 
         create("genshinSpoof") {
             manifestPlaceholders += mapOf("appNameBase" to "Eden Optimized")
-            dimension = "version"
+            dimension = "edenVersion"
             minSdk = 35
             resValue("string", "app_name_suffixed", "Eden Optimized")
 
@@ -165,7 +166,7 @@ android {
 
         create("legacy") {
             manifestPlaceholders += mapOf("appNameBase" to "Eden Legacy")
-            dimension = "version"
+            dimension = "edenVersion"
             minSdk = 29
             resValue("string", "app_name_suffixed", "Eden Legacy")
 
@@ -188,7 +189,7 @@ android {
 
         create("chromeOS") {
             manifestPlaceholders += mapOf("appNameBase" to "Eden ChromeOS")
-            dimension = "version"
+            dimension = "edenVersion"
             resValue("string", "app_name_suffixed", "Eden ChromeOS")
 
             ndk {
