Date: Sun, 8 Nov 2026 22:05:46 -0600
Subject: [PATCH 2/2] Android build: unique root project name (Nebulos
 composite build rejects duplicate default names)

---
 src/android/settings.gradle.kts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/android/settings.gradle.kts b/src/android/settings.gradle.kts
index 7eab9ec61..2170ed874 100644
--- a/src/android/settings.gradle.kts
+++ b/src/android/settings.gradle.kts
@@ -20,3 +20,6 @@ dependencyResolutionManagement {
 }
 
 include(":app")
+
+// Unique root name: Nebulos composes several Android builds and Gradle (idea plugin) rejects duplicate default names.
+rootProject.name = "azahar-android"
