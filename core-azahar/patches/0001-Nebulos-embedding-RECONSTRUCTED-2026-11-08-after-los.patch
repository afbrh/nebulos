+// NEBULOS (reconstructed): optional real-folder overrides for the SDMC / NAND / states directories.
+struct SaveOverrides {
+    std::string sdmc;
+    std::string nand;
+    std::string states;
+};
+static SaveOverrides g_save_overrides;
+
+static void ApplySaveDirectoryOverrides() {
+    const auto apply = [](UserPath which, const std::string& dir) {
+        if (dir.empty()) {
+            return;
+        }
+        std::string path = dir;
+        while (path.size() > 1 && (path.back() == '/' || path.back() == '\\')) {
+            path.pop_back();
+        }
+#if defined(ANDROID) && !defined(HAVE_LIBRETRO_VFS)
+        // "!" at the front of a path marks it as an already-native (absolute) path: not relative to the user directory.
+        if (path.front() != '!') {
+            path.insert(path.begin(), '!');
+        }
+#endif
+        g_paths[which] = path + DIR_SEP;
+    };
+    apply(UserPath::SDMCDir, g_save_overrides.sdmc);
+    apply(UserPath::NANDDir, g_save_overrides.nand);
+    apply(UserPath::StatesDir, g_save_overrides.states);
+}
+
