+
+void Java_org_citra_citra_1emu_NativeLibrary_setFourThreeFill([[maybe_unused]] JNIEnv* env,
+                                                              [[maybe_unused]] jobject obj,
+                                                              jboolean on) {
+    // NOT RECOVERED: the original drew the top screen as a native 4:3 picture in the renderer. Only the flag is kept here.
+    four_three_fill = (on != JNI_FALSE);
+    LOG_INFO(Frontend, "Nebulos 4:3 fill: {}", on != JNI_FALSE);
+}
+
+void Java_org_citra_citra_1emu_NativeLibrary_setFramePatch(JNIEnv* env,
+                                                           [[maybe_unused]] jobject obj,
+                                                           jint flag_addr, jintArray j_on,
+                                                           jintArray j_off, jintArray j_once,
+                                                           jboolean enable) {
+    const auto to_vec = [env](jintArray arr) {
+        std::vector<u32> out;
+        if (arr == nullptr) {
+            return out;
+        }
+        const jsize n = env->GetArrayLength(arr);
+        out.resize(static_cast<std::size_t>(n));
+        if (n > 0) {
+            env->GetIntArrayRegion(arr, 0, n, reinterpret_cast<jint*>(out.data()));
+        }
+        return out;
+    };
+    std::scoped_lock lock{frame_patch_mutex};
+    frame_patch.flag_addr = static_cast<u32>(flag_addr);
+    frame_patch.on = to_vec(j_on);
+    frame_patch.off = to_vec(j_off);
+    frame_patch.once = to_vec(j_once);
+    frame_patch.enable = enable != JNI_FALSE;
+    frame_patch.dirty = true;
+    // Active whenever a patch set exists: when off, the original words are enforced again (a save state made with it on must not
+    // leave it half on).
+    frame_patch_active = !frame_patch.on.empty() || !frame_patch.off.empty();
+}
