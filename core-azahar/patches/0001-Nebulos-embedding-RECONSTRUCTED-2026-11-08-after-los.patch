+// NEBULOS (reconstructed 2026-11-08; original source lost)
+// Licensed under GPLv3 or any later version
+// Refer to the LICENSE.txt file included.
+
+package org.citra.citra_emu.features.settings.model
+
+import org.citra.citra_emu.features.settings.utils.SettingsFile
+
+/**
+ * Compatibility layer for the Nebulos host (core-azahar), which was written against an older Azahar whose settings were enum fields
+ * (`IntSetting.GRAPHICS_API.int = 2`, `SettingsFile.saveFile("config", setting)`). Upstream now keeps values in [CitraSettings.activeSettings]
+ * (global values + per-game overrides), so these helpers read and write there.
+ */
+internal object NebulosSettings {
+    /**
+     * The host writes settings before the stock EmulationActivity has loaded config.ini. Load it first, otherwise a lone host-written value
+     * would make activeSettings look "already loaded" and the rest of the user's config.ini would be skipped.
+     */
+    private fun ensureLoaded() {
+        val s = CitraSettings.activeSettings
+        if (s.getAllGlobal().isEmpty()) {
+            runCatching { SettingsFile.loadGlobalSettings(s) }
+        }
+    }
+
+    fun <T> get(setting: AbstractSetting<T>): T {
+        ensureLoaded()
+        return CitraSettings.activeSettings.get(setting)
+    }
+
+    fun <T> set(setting: AbstractSetting<T>, value: T) {
+        ensureLoaded()
+        CitraSettings.activeSettings.setByCurrentState(setting, value)
+    }
+
+    fun <T> save(setting: AbstractSetting<T>) {
+        ensureLoaded()
+        SettingsFile.saveSetting(setting, CitraSettings.activeSettings)
+    }
+}
