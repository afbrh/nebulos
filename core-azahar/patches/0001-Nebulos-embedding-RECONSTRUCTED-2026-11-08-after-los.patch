+// NEBULOS (reconstructed 2026-11-08 from decompiled Nebulos Release 15; original source lost)
+// Licensed under GPLv2 or any later version
+// Refer to the misc/licenses/gplv2.txt file included.
+
+package org.citra.citra_emu.utils
+
+import android.util.Log
+
+/**
+ * The seam between Azahar and the Nebulos shell. Azahar never shows its own toasts, loading overlay text or error dialogs when embedded:
+ * they are routed here, and the Nebulos core (core-azahar, AzaharHost) installs the callbacks while a game Activity is up. A ready
+ * signal that arrives before the callbacks exist is held ([fireReady] keeps a pending flag, [flushPending] replays it).
+ */
+object NebulosBridge {
+    @Volatile var notice: ((String) -> Unit)? = null
+    @Volatile var error: ((String, String, Boolean) -> Unit)? = null
+    @Volatile var ready: (() -> Unit)? = null
+    @Volatile var progress: ((Float, String?) -> Unit)? = null
+    @Volatile var loadingText: ((String) -> Unit)? = null
+
+    @Volatile private var pendingReady = false
+    @Volatile var fatalShown = false
+    private val errorLock = Object()
+
+    fun notice(msg: CharSequence) {
+        Log.i("Nebulos", " notice: $msg")
+        notice?.invoke(msg.toString())
+    }
+
+    fun error(title: String, message: String, fatal: Boolean) {
+        Log.e("Nebulos", " error: $title - $message")
+        if (fatal) fatalShown = true
+        error?.invoke(title, message, fatal)
+    }
+
+    /** The game drew its first frame. */
+    fun fireReady() {
+        val r = ready
+        if (r == null) pendingReady = true else r()
+    }
+
+    fun flushPending() {
+        if (pendingReady) {
+            pendingReady = false
+            ready?.invoke()
+        }
+    }
+
+    /** After a fatal error the emulation thread must not carry on: park it until the process ends. */
+    fun parkAfterFatal() {
+        fatalShown = true
+        synchronized(errorLock) {
+            while (true) errorLock.wait()
+        }
+    }
+}
