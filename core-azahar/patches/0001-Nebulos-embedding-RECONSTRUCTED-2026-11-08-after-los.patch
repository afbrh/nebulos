+// NEBULOS (reconstructed): enforce the frame patch on the running application's memory. Emulation thread only.
+static void ApplyFramePatch(Core::System& system) {
+    if (!frame_patch_active.load(std::memory_order_relaxed)) {
+        return;
+    }
+    std::scoped_lock lock{frame_patch_mutex};
+    auto process = system.Kernel().GetProcessById(system.CheatEngine().GetConnectedPID());
+    if (!process) {
+        return;
+    }
+    Memory::MemorySystem& memory = system.Memory();
+
+    const auto read = [&](u32 addr) -> u32 {
+        return (addr & 0x80000000u) ? memory.Read16(*process, addr & 0x7FFFFFFFu)
+                                    : memory.Read32(*process, addr);
+    };
+    // Writes only when different (so self-modifying-code caches are invalidated only when something changed).
+    const auto write_pairs = [&](const std::vector<u32>& pairs) {
+        for (std::size_t i = 0; i + 1 < pairs.size(); i += 2) {
+            const u32 addr = pairs[i];
+            const u32 value = pairs[i + 1];
+            const u32 real = addr & 0x7FFFFFFFu;
+            if (addr & 0x80000000u) {
+                if (memory.Read16(*process, real) != static_cast<u16>(value)) {
+                    memory.Write16(*process, real, static_cast<u16>(value));
+                    system.InvalidateCacheRange(real, 2);
+                }
+            } else if (memory.Read32(*process, real) != value) {
+                memory.Write32(*process, real, value);
+                system.InvalidateCacheRange(real, 4);
+            }
+        }
+    };
+
+    if (frame_patch.dirty) {
+        frame_patch.dirty = false;
+        frame_patch.verified = false;
+        frame_patch.refused = false;
+        if (!frame_patch.enable) {
+            frame_patch.once_pending = true;
+        }
+    }
+
+    if (frame_patch.enable) {
+        if (!frame_patch.verified) {
+            // Only switch on if the words about to be patched still hold the original values of the build the patch was made for.
+            for (std::size_t i = 0; i + 1 < frame_patch.off.size(); i += 2) {
+                const u32 addr = frame_patch.off[i];
+                const u32 expected = frame_patch.off[i + 1];
+                const u32 actual = read(addr);
+                const u32 mask = (addr & 0x80000000u) ? 0xFFFFu : 0xFFFFFFFFu;
+                if ((actual & mask) != (expected & mask)) {
+                    LOG_ERROR(Frontend,
+                              "Nebulos 60 fps patch: {:#x} holds {:#x}, not the expected {:#x}: "
+                              "patch disabled",
+                              addr & 0x7FFFFFFFu, actual, expected);
+                    frame_patch.refused = true;
+                    break;
+                }
+            }
+            frame_patch.verified = true;
+            if (!frame_patch.refused) {
+                LOG_INFO(Frontend, "Nebulos 60 fps patch: on ({} on words, {} off words)",
+                         frame_patch.on.size() / 2, frame_patch.off.size() / 2);
+            }
+        }
+        if (!frame_patch.refused) {
+            write_pairs(frame_patch.on);
+        }
+    } else {
+        write_pairs(frame_patch.off);
+        if (frame_patch.once_pending) {
+            frame_patch.once_pending = false;
+            write_pairs(frame_patch.once);
+            LOG_INFO(Frontend, "Nebulos 60 fps patch: off ({} on words, {} off words)",
+                     frame_patch.on.size() / 2, frame_patch.off.size() / 2);
+        }
+    }
+}
