+// NEBULOS: the SDL Java classes (org.libsdl.app, byte-identical to Eden's) must exist once in the merged app, but both Eden and Lichii package them
+// and R8 refuses duplicates. Lichii's runtime classes jar is stripped of them after it is built; the Eden copy serves both native libraries.
+tasks.matching { it.name.startsWith("bundleLibRuntimeToJar") }.configureEach {
+    doLast {
+        outputs.files.files.filter { it.isFile && it.name.endsWith(".jar") }.forEach { jar ->
+            val tmp = File(jar.parentFile, jar.name + ".tmp")
+            ZipInputStream(jar.inputStream()).use { zin ->
+                ZipOutputStream(tmp.outputStream()).use { zout ->
+                    generateSequence { zin.nextEntry }.forEach { e ->
+                        if (!e.name.startsWith("org/libsdl/")) {
+                            zout.putNextEntry(ZipEntry(e.name))
+                            zin.copyTo(zout)
+                            zout.closeEntry()
+                        }
+                    }
+                }
+            }
+            tmp.copyTo(jar, overwrite = true)
+            tmp.delete()
         }
     }
 }
