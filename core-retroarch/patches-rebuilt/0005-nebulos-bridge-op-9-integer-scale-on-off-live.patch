From 204bc4dd767deac9f9a558bed85ea83750e453fd Mon Sep 17 00:00:00 2001
From: Ry <ry@Rys-MacBook-Pro.eau.wi.charter.com>
Date: Fri, 23 Oct 2026 12:53:27 -0500
Subject: [PATCH 5/5] nebulos bridge: op 9, integer scale on/off live

---
 nebulos_bridge.c | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/nebulos_bridge.c b/nebulos_bridge.c
index 4b872f3dcc..27782bba84 100644
--- a/nebulos_bridge.c
+++ b/nebulos_bridge.c
@@ -37,7 +37,7 @@ static atomic_int   rc_axes[2][2];            /* [stick L/R][x/y] in -0x7fff..0x
 
 static pthread_mutex_t rc_mutex = PTHREAD_MUTEX_INITIALIZER;
 static pthread_cond_t  rc_cond  = PTHREAD_COND_INITIALIZER;
-static int rc_op      = 0;   /* 0 none, 1 save, 2 load, 3 pause, 4 resume, 5 quit, 6 flush, 7 fast-forward, 8 shader preset */
+static int rc_op      = 0;   /* 0 none, 1 save, 2 load, 3 pause, 4 resume, 5 quit, 6 flush, 7 fast-forward, 8 shader preset, 9 integer scale */
 static int rc_arg     = 0;
 static char rc_path[PATH_MAX_LENGTH];
 static int rc_pending = 0;
@@ -159,6 +159,11 @@ static void nebulos_exec(int op, int arg, const char *path, int *res)
          *res = command_set_shader(NULL, path) ? 1 : 0;
 #endif
          break;
+      case 9: /* integer scale: arg 1 = on, 0 = off; the viewport follows within a frame */
+         config_get_ptr()->bools.video_scale_integer = (arg != 0);
+         command_event(CMD_EVENT_VIDEO_SET_ASPECT_RATIO, NULL);
+         *res = 1;
+         break;
       case 6: /* flush battery saves (SRAM/RTC) to disk now */
          command_event(CMD_EVENT_SAVE_FILES, NULL);
          *res = 1;
@@ -177,7 +182,7 @@ static void rc_service(int allow_state_ops)
    if (!rc_pending) /* cheap racy check; re-checked under lock */
       return;
    pthread_mutex_lock(&rc_mutex);
-   if (!rc_pending || (!allow_state_ops && (rc_op == 1 || rc_op == 2 || rc_op == 8)))
+   if (!rc_pending || (!allow_state_ops && (rc_op == 1 || rc_op == 2 || rc_op == 8 || rc_op == 9)))
    {
       pthread_mutex_unlock(&rc_mutex);
       return;
