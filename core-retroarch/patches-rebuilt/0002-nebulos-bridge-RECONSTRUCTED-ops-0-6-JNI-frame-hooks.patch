+/* Nebulos bridge hooks (RECONSTRUCTED, see nebulos_bridge.c).
+ * Called from RetroArch's own loops; all are no-ops until Nebulos drives them. */
+#ifndef NEBULOS_BRIDGE_H
+#define NEBULOS_BRIDGE_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* android_input_poll(): once per input poll (before, and from inside, retro_run). */
+void nebulos_bridge_poll(void);
+/* core_run(): around retro_run(). State ops are deferred while a frame is running. */
+void nebulos_bridge_run_begin(void);
+void nebulos_bridge_run_end(void);
+/* input_driver_state_wrapper(): merges Nebulos' injected pad/stick state for libretro port 0 into the result. */
+int16_t nebulos_bridge_overlay(unsigned port, unsigned device, unsigned idx, unsigned id, int16_t ret);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
