+        extern bool widescreen_crop_on(void);  // (Fill (crop): TOTK's layout camera has f[14] 0 where 1.8.2's has -1)
+        if (widescreen_ui_centred() && t0 && vk_texture_scale_group(t0) == RS_OUT && f[12] == 0 && f[13] == 0 &&
+            (f[14] == -1.0f || (f[14] == 0.0f && widescreen_crop_on())) && f[1] == 0 && f[2] == 0) {
             float g = widescreen_factor();
             extern bool framepace_in_menu(void);
             if (g_debug_frame && size >= 0x230 && f[15] == 0)
@@ -4723,7 +4724,8 @@ static VkDescriptorBufferInfo cbuf_info(int stage, ShaderInfo *si, int k, uint32
                 if (full_width_pane(f))
                     for (int i = 16; i < 20; i++) m[i] *= g;
                 return ubo_span(c, size);
-            } else if (size >= 0x230 && f[15] == 0 && f[0] > 0 && fabsf(f[5] / f[0] - 16.0f / 9.0f * g) < 0.01f) {
+            } else if (size >= 0x230 && (f[15] == 0 || (f[15] == 1.0f && widescreen_crop_on())) && f[0] > 0 &&
+                       fabsf(f[5] / f[0] - 16.0f / 9.0f * g) < 0.01f) {
                 float d = widescreen_hud_shift(f[19]);
                 if (d != 0) {
                     panefix_log("hud-shift", f);
@@ -4738,10 +4740,12 @@ static VkDescriptorBufferInfo cbuf_info(int stage, ShaderInfo *si, int k, uint32
                 for (int i = 0; i < 4; i++) ((float *)c.ptr)[i] /= g;
                 return ubo_span(c, size);
             } else if (f[15] > 1.0f) {
-                float d = widescreen_hud_shift(f[3] / f[15] * g * 640.0f);  // (layout x of the origin: 640 g units a side)
+                extern float widescreen_layout_half(void);  // (640 g units a side; TOTK's cropped layouts: 960)
+                float half = widescreen_layout_half();
+                float d = widescreen_hud_shift(f[3] / f[15] * g * half);  // (layout x of the origin)
                 if (d != 0) {
                     VkSpan c = vk_transient_copy(f, size, 256);
-                    float *m = (float *)c.ptr, k = d / (640.0f * g);  // (that many NDC units)
+                    float *m = (float *)c.ptr, k = d / (half * g);  // (that many NDC units)
                     for (int i = 0; i < 4; i++) m[i] += k * m[12 + i];
                     return ubo_span(c, size);
                 }
