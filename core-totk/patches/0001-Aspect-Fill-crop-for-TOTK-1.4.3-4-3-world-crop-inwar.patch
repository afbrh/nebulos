diff --git a/runtime/hle/widescreen.c b/runtime/hle/widescreen.c
index 140831f..bcf5769 100644
--- a/runtime/hle/widescreen.c
+++ b/runtime/hle/widescreen.c
@@ -18,6 +18,7 @@
 #include <stdint.h>
 
 #include <string.h>
+#include <stdlib.h>
 
 #include "../framepace.h"
 #include "../hle.h"
@@ -126,7 +127,15 @@ uint32_t rt_persp_aspect(uint64_t proj) {
 
 // The game's cameras are widened (the 1.8.2 hooks above): its HUD, drawn through one, lands in the centred 16:9 part
 // of a wide final image (exec.c scissor_rect maps the HUD's scissors there).
-bool widescreen_ui_centred(void) { return widescreen_allowed() && g_wide != 1.0f && g_widened; }
+// Aspect "Fill (crop)" with the world up (minimap on screen): the picture is cropped to the window (widescreen_present_crop),
+// so the HUD's panes near the sides move IN by the cropped margin (widescreen_hud_shift)
+static bool in_world(void);
+static bool crop_active(void) {  // (the 3D scene up: menus, the title and loading screens keep 16:9 with bars; verified on the pause menu)
+    return g_settings.aspect == ASPECT_CROP && g_shape < 0.999f && g_shape > 0.1f && in_world();
+}
+bool widescreen_crop_on(void) { return crop_active(); }
+float widescreen_layout_half(void) { return crop_active() ? 960.0f : 640.0f; }  // (the layouts' half width: TOTK's are 1920 wide)
+bool widescreen_ui_centred(void) { return (widescreen_allowed() && g_wide != 1.0f && g_widened) || crop_active(); }
 
 // The HUD out to the screen's edges: how far a pane of the game's 1280x720 layouts moves, from its centre x in
 // layout units (-640..640). The widened layout camera draws the layout in the middle 16:9 part; panes nearer its sides
@@ -196,6 +205,16 @@ bool widescreen_talk(void) {
 float widescreen_hud_shift(float x) {
     // (TOTK: its menus aren't told apart from the world yet - framepace_in_menu is 1.8.2's - so the HUD stays in the
     // middle 16:9 part there, where the inventory's grids keep together; LARECOMP_TOTK_HUD_EDGES=1 tries the edges)
+    if (crop_active()) {  // (cropped: the margin each side is (1 - shape) / 2 of the layout's width, in the pane's units)
+        static float U;
+        if (U == 0) U = ENV("LARECOMP_CROP_UNITS") ? (float)atof(getenv("LARECOMP_CROP_UNITS")) : 960.0f;
+        float sc = U / 640.0f, ax = x < 0 ? -x : x, t = (ax - 180.0f * sc) / (80.0f * sc);
+        if (t <= 0) return 0;
+        if (t > 1) t = 1;
+        t = t * t * (3 - 2 * t);
+        float in = U * (1.0f - g_shape) * t;
+        return x < 0 ? in : -in;
+    }
     if (g_game_version == GAME_V_143 && !ENV("LARECOMP_TOTK_HUD_EDGES")) return 0;
     if (!widescreen_ui_centred() || framepace_in_menu() || !in_world()) return 0;
     float ax = x < 0 ? -x : x, t = (ax - 180.0f) / (260.0f - 180.0f);
@@ -221,6 +240,14 @@ void widescreen_scene_ubo(const float *u, uint64_t size) { (void)u, (void)size;
 void widescreen_present_crop(uint64_t frame, double shape, float crop[4], double *vx, double *vy, double *vw, double *vh) {
     (void)frame, (void)vy, (void)vh;
     crop[0] = crop[1] = 0, crop[2] = crop[3] = 1;
+    // Aspect "Fill (crop)": a window narrower than 16:9 (the Nova's 4:3) shows the world as the picture's middle part,
+    // filling the window; menus, the title, loading screens and cutscenes (no minimap) keep the whole picture with bars
+    if (crop_active()) {
+        double s = g_shape, nh = *vh / s;  // (the 16:9 box fitted by width is vh high; the window is vh / s)
+        crop[2] = (float)s, crop[0] = (1.0f - crop[2]) * 0.5f;
+        *vy -= (nh - *vh) * 0.5, *vh = nh;
+        return;
+    }
     if (shape <= 1.001 || !widescreen_allowed() || in_world()) return;
     // (TOTK: the whole image - its layouts are kept in their proportions as they're drawn, vulkan/exec.c cbuf_info;
     // squeezed back here, the save list, the loading screens and the menus had bars)
