+#define SDL_PLATFORM_TVOS 1
+#endif
+
+#if TARGET_OS_VISION
+
+/**
+ * A preprocessor macro that is only defined if compiling for visionOS.
+ *
+ * \since This macro is available since SDL 3.2.0.
+ *
+ * \sa SDL_PLATFORM_APPLE
