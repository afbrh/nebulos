+#define SDL_ELF_NOTE_DLOPEN(args...)
+
+#elif defined(_MSC_VER) && _MSC_VER < 1400
+
+/* Variadic macros are not supported */
+
+#else
+
+#define SDL_ELF_NOTE_DLOPEN(...)
+
+#endif
