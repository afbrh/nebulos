+ * An enumeration of hint priorities.
+ *
+ * \since This enum is available since SDL 3.2.0.
+ */
+typedef enum SDL_HintPriority
+{
+    SDL_HINT_DEFAULT,
+    SDL_HINT_NORMAL,
+    SDL_HINT_OVERRIDE
