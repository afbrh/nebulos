From ca73761aae19d0cb5b7d23a83fbb52458b7b9e33 Mon Sep 17 00:00:00 2001
From: local <local@localhost>
Date: Thu, 19 Nov 2026 08:11:26 -0600
Subject: [PATCH 03/10] Face buttons by the Nova pad's labels: south = A, east
 = B, west = X, north = Y (local only)

---
 runtime/hle/bindings.c | 4 ++--
 runtime/ui/launcher.mm | 4 ++--
 runtime/ui/menu.mm     | 4 ++--
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/runtime/hle/bindings.c b/runtime/hle/bindings.c
index a20e221..4075578 100644
--- a/runtime/hle/bindings.c
+++ b/runtime/hle/bindings.c
@@ -10,11 +10,11 @@
 
 _Static_assert(PADB_LTRIGGER == SDL_GAMEPAD_BUTTON_COUNT, "trigger pseudo-buttons follow SDL's buttons");
 
-// Defaults: Nintendo layout by position (east = A, south = B, north = X, west = Y), triggers = ZL / ZR;
+// Defaults: the labels of the Nova's pad (south = A, east = B, west = X, north = Y; local change: the Nintendo layout by position was east = A, south = B, north = X, west = Y), triggers = ZL / ZR;
 // keyboard WASD left stick, arrows d-pad, K/J/L/I = A/B/X/Y, Q/E = L/R, 1/3 = ZL/ZR, Enter / Backspace = Plus /
 // Minus, F / numpad 0 = stick clicks, numpad 8/5/4/6 right stick.
 #define DEF_PAD { \
-    SDL_GAMEPAD_BUTTON_EAST, SDL_GAMEPAD_BUTTON_SOUTH, SDL_GAMEPAD_BUTTON_NORTH, SDL_GAMEPAD_BUTTON_WEST, \
+    SDL_GAMEPAD_BUTTON_SOUTH, SDL_GAMEPAD_BUTTON_EAST, SDL_GAMEPAD_BUTTON_WEST, SDL_GAMEPAD_BUTTON_NORTH, \
     SDL_GAMEPAD_BUTTON_LEFT_STICK, SDL_GAMEPAD_BUTTON_RIGHT_STICK, SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, \
     SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, PADB_LTRIGGER, PADB_RTRIGGER, SDL_GAMEPAD_BUTTON_START, SDL_GAMEPAD_BUTTON_BACK, \
     SDL_GAMEPAD_BUTTON_DPAD_LEFT, SDL_GAMEPAD_BUTTON_DPAD_UP, SDL_GAMEPAD_BUTTON_DPAD_RIGHT, SDL_GAMEPAD_BUTTON_DPAD_DOWN}
diff --git a/runtime/ui/launcher.mm b/runtime/ui/launcher.mm
index eddd0e1..1d4a2fa 100644
--- a/runtime/ui/launcher.mm
+++ b/runtime/ui/launcher.mm
@@ -1573,8 +1573,8 @@ static bool menu_item(const char *label, bool enabled, bool *hovered = NULL, con
 // switched off: it used the Xbox layout and, per the user, didn't work on the start screen.)
 static ImGuiKey launcher_pad_key(Uint8 b) {
     switch (b) {
-    case SDL_GAMEPAD_BUTTON_EAST: return ImGuiKey_GamepadFaceDown;   // A: activate
-    case SDL_GAMEPAD_BUTTON_SOUTH: return ImGuiKey_GamepadFaceRight; // B: back
+    case SDL_GAMEPAD_BUTTON_SOUTH: return ImGuiKey_GamepadFaceDown;   // A: activate
+    case SDL_GAMEPAD_BUTTON_EAST: return ImGuiKey_GamepadFaceRight; // B: back
     case SDL_GAMEPAD_BUTTON_NORTH: return ImGuiKey_GamepadFaceUp;
     case SDL_GAMEPAD_BUTTON_WEST: return ImGuiKey_GamepadFaceLeft;
     case SDL_GAMEPAD_BUTTON_DPAD_UP: return ImGuiKey_GamepadDpadUp;
diff --git a/runtime/ui/menu.mm b/runtime/ui/menu.mm
index 64a336e..53f0ee6 100644
--- a/runtime/ui/menu.mm
+++ b/runtime/ui/menu.mm
@@ -130,8 +130,8 @@ static ImGuiKey key_from_scancode(SDL_Scancode sc) {
 // Nintendo layout: the right face button (A) confirms, the bottom one (B) goes back.
 static ImGuiKey key_from_pad(Uint8 b) {
     switch (b) {
-    case SDL_GAMEPAD_BUTTON_EAST: return ImGuiKey_GamepadFaceDown;   // activate
-    case SDL_GAMEPAD_BUTTON_SOUTH: return ImGuiKey_GamepadFaceRight; // cancel / back
+    case SDL_GAMEPAD_BUTTON_SOUTH: return ImGuiKey_GamepadFaceDown;   // activate
+    case SDL_GAMEPAD_BUTTON_EAST: return ImGuiKey_GamepadFaceRight; // cancel / back
     case SDL_GAMEPAD_BUTTON_NORTH: return ImGuiKey_GamepadFaceUp;
     case SDL_GAMEPAD_BUTTON_WEST: return ImGuiKey_GamepadFaceLeft;
     case SDL_GAMEPAD_BUTTON_DPAD_UP: return ImGuiKey_GamepadDpadUp;
-- 
